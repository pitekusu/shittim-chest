{
  "name": "shittim-records-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "node scripts/generate-contract-validator.mjs --write",
    "contracts:check": "node scripts/generate-contract-validator.mjs --check",
    "dev": "vp dev",
    "check": "vp check",
    "test": "vp test",
    "test:e2e": "playwright test",
    "build": "vp build",
    "audit": "pnpm audit --audit-level=low",
    "verify": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e && pnpm run audit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
