{
  "name": "shittim-records-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "node scripts/generate-contract-validator.mjs --write",
    "contracts:check": "node scripts/generate-contract-validator.mjs --check",
    "og:image:generate": "node scripts/generate-og-image.mjs",
    "dev": "vp dev",
    "check": "vp check --deny-warnings --continue-on-error",
    "test": "vp test",
    "test:failed": "vp test run --last-failed",
    "test:e2e": "playwright test",
    "build": "node scripts/check-fonts.mjs && vp build && node scripts/check-code-splitting.mjs && node scripts/check-public-page-html.mjs",
    "audit": "pnpm audit --audit-level=low",
    "verify": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e && pnpm run audit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-virtual": "3.14.26",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "yet-another-react-lightbox": "3.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/ui": "5.1.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@12.20.0"
}
