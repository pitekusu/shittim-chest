{
  "name": "shittim-chest-infrastructure",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test:infra": "vitest run infra/test --testTimeout=15000",
    "audit:infra": "npm audit --audit-level=low --json | node infra/check-audit.mjs",
    "cdk": "cdk",
    "cdk:list": "cdk list",
    "cdk:list:records": "cdk list --app 'node --import tsx infra/bin/shittim-records.ts'",
    "synth": "cdk synth --strict",
    "synth:records": "cdk synth --strict --app 'node --import tsx infra/bin/shittim-records.ts'",
    "check:infra": "npm run build && npm run test:infra && npm run synth"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1139.0",
    "cdk-nag": "3.0.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
